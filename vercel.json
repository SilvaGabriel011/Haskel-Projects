{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "haskel-site",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/book",
      "destination": "https://ops.haskelprojects.com.au/book"
    },
    {
      "source": "/api/book",
      "destination": "https://ops.haskelprojects.com.au/api/book"
    }
  ]
}
