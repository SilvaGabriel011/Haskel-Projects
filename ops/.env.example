# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- database -------------------------------------------------------------
# What the app connects with. On Supabase use the POOLED url (port 6543) and
# append ?pgbouncer=true; locally, the plain connection string.
DATABASE_URL=

# Local development with Docker:
#   docker run -d --name haskel-pg -e POSTGRES_PASSWORD=haskel_dev \
#     -e POSTGRES_USER=haskel -e POSTGRES_DB=haskel_ops -p 5433:5432 postgres:17-alpine
#   DATABASE_URL=postgresql://haskel:haskel_dev@127.0.0.1:5433/haskel_ops
#
# Supabase: Connect -> Connection string.
# Migrations need a session connection (port 5432), not the pooler on 6543.
# Use the SESSION POOLER string, not "Direct connection": the direct host is
# IPv6 only and Vercel's build machines cannot reach it. Locally, leave this
# unset and DATABASE_URL is used for both.
DIRECT_URL=

# Required. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# The Google Workspace domain staff sign in from.
# Sign-in is refused for any account outside this domain — and in production,
# refused entirely while this is blank.
GOOGLE_WORKSPACE_DOMAIN=haskelproject.com.au

# Production only. When set, visits on the <project>.vercel.app address are
# sent here, the one address Google sign-in accepts. Leave blank locally.
CANONICAL_HOST=

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email, for "Forgot PIN?" codes on a shared login (README, "Shared logins").
# A Resend API key, and a sender on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM="Haskel Ops <noreply@haskelproject.com.au>"

# Calendar sync. Stays off until all three of these are set (README, step 8).
# The service account's key file from Google Cloud, pasted whole as one value.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The ID comes from Google Calendar -> Settings and sharing -> Integrate calendar.
# Share that calendar with the service account ("Make changes to events").
# Point it at a throwaway calendar first, never the live one.
GOOGLE_CALENDAR_ID=
# IANA zone the business works in. Adelaide is UTC+9:30 and observes DST, so
# never substitute a fixed offset. Unset means times fall back to the server's
# zone, which on Vercel is UTC — that is how a 9am job reads as 11:30pm.
# Set this in Vercel too, not just here.
BUSINESS_TIMEZONE=Australia/Adelaide

# How clients reach the business, at the end of the job summary New job emails
# them (uses RESEND_API_KEY and MAIL_FROM above). Optional: the email goes from
# a no-reply address, so give a phone or inbox someone reads, e.g. "0451 083 862".
BUSINESS_CONTACT=

# Booking form rate limit: how many reverse proxies sit in front of the app.
# Off Vercel only (Vercel sets the client address itself). The client's own
# address is read this many entries in from the right of X-Forwarded-For, the
# entries our proxies added; anything further left the client could have
# written. Blank means 1. With no proxy at all, set 0: every request then
# shares one limit, which is strict but cannot be dodged by faking a header.
TRUSTED_PROXY_HOPS=

# Demo mode: adds password sign-in for the seeded demo accounts so the system
# can be explored before Google sign-in is set up.
#
# Defaults to OFF on purpose. Copying this file should never hand a deployment
# a working password login by accident. Switch it on deliberately while you are
# exploring, and off again before real data goes in. While it is on, every page
# carries a banner saying so.
DEMO_MODE=false

# Password hashes for the demo accounts. Generate each with:  npm run hash
# Format: scrypt:<salt-hex>:<hash-hex>.  Plain passwords are never stored.
# Note the ":" separators — a "$" here would be expanded away as a variable.
DEMO_ADMIN_PASSWORD_HASH=
DEMO_INSTALLER_PASSWORD_HASH=
DEMO_APPRENTICE_PASSWORD_HASH=
# The shared login info@ (Mia and Tom, demo PINs 2580 and 1470).
DEMO_INFO_PASSWORD_HASH=
