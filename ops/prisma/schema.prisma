// Haskel Ops — schema.
//
// Two rules that run through all of this:
//
//  1. MONEY IS INTEGER CENTS. Never a float, never a Decimal. Field names carry
//     the unit (quoteCents, costPerSqmCents) so a bare number is never ambiguous.
//  2. ONE ORDER TABLE, TWO PIPELINES. Offcut and small jobs run a short pipeline,
//     benchtop installs the full one, but both are rows in `Order` with a shared
//     status enum and a `pipeline` discriminator. That is what lets the financials
//     report across both from a single query — see lib/pipeline.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- people

enum Role {
  ADMIN
  EMPLOYEE
}

/// A person who uses the app. Several people can share one sign-in email
/// (info@…): each is their own User, with their own role, and proves who they
/// are with a PIN after signing in. That email is the "owner" of what they do.
model User {
  id        String   @id @default(cuid())
  /// The Google account they sign in with. Not unique: a shared login has
  /// one User per person.
  email     String
  name      String
  role      Role     @default(EMPLOYEE)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  /// When they finished the first-login walkthrough (/welcome). Null means
  /// the dashboard sends them there once.
  onboardedAt DateTime?
  /// The last release they were told about (lib/releases.ts). Null means
  /// never, so the dashboard shows them the latest What's new once.
  seenVersion String?
  /// scrypt hash of their 4-digit PIN. Needed only on a shared login, to pick
  /// themselves after signing in. Null on a login of their own.
  pinHash        String?
  /// Wrong PINs in a row; five locks picking them for 15 minutes.
  pinFailures    Int       @default(0)
  pinLockedUntil DateTime?
  /// "Forgot PIN?": a one-time code emailed to the login (lib/pin-reset.ts),
  /// stored hashed, good for 10 minutes and 5 tries.
  pinResetHash    String?
  pinResetExpires DateTime?
  pinResetTries   Int       @default(0)
  pinResetSentAt  DateTime?

  movements  StockMovement[]
  shifts     ScheduleAssignee[]
  stageMoves OrderStage[]
  activities Activity[]

  @@unique([email, name])
  @@index([email])
  @@index([active])
}

/// Every action worth a record: who signed in (the owner, the login email) and
/// which person on it did it (the user). Written alongside the change itself.
model Activity {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  /// The login used, e.g. info@haskelproject.com.au.
  ownerEmail String
  /// The person. Kept by name too, so the record reads the same after they leave.
  userId     String?
  userName   String
  /// A stable key, e.g. "job.opened", for filtering.
  action     String
  /// What happened, in words: "Opened HP-2610-004 for Hills Kitchens".
  summary    String
  /// Where to see it.
  href       String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([ownerEmail, at])
  @@index([userId, at])
}

// ---------------------------------------------------------------- stock

enum MaterialKind {
  ENGINEERED
  NATURAL
  SINTERED
}

enum SlabStatus {
  IN_STOCK
  RESERVED
  CUT // broken down; offcuts may remain
  SOLD
}

enum OffcutStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Material {
  id              String       @id @default(cuid())
  name            String       @unique
  kind            MaterialKind
  supplier        String
  thicknessMm     Int          @default(20)
  finish          String
  costPerSqmCents Int

  slabs   Slab[]
  offcuts Offcut[]
  lines   OrderLine[]

  @@index([kind])
}

model Slab {
  id         String     @id @default(cuid())
  ref        String     @unique // e.g. SLB-0142
  materialId String
  widthMm    Int
  lengthMm   Int
  status     SlabStatus @default(IN_STOCK)
  rack       String
  costCents  Int // what we paid for this slab
  arrivedAt  DateTime
  photoUrl   String?

  material  Material        @relation(fields: [materialId], references: [id])
  offcuts   Offcut[]
  movements StockMovement[]
  lines     OrderLine[]

  @@index([status])
  @@index([materialId])
}

/// An offcut is a first-class tracked item, not a note on a slab. This is the
/// business's specialty, and `listedPublicly` is what the public offcuts page
/// reads from once it stops being hand-edited cards.
model Offcut {
  id             String       @id @default(cuid())
  ref            String       @unique // e.g. OFF-0231
  parentSlabId   String?
  materialId     String
  widthMm        Int
  lengthMm       Int
  thicknessMm    Int          @default(20)
  finish         String
  status         OffcutStatus @default(AVAILABLE)
  rack           String
  listedPublicly Boolean      @default(false)
  notes          String?
  createdAt      DateTime     @default(now())

  parentSlab Slab?           @relation(fields: [parentSlabId], references: [id])
  material   Material        @relation(fields: [materialId], references: [id])
  movements  StockMovement[]
  lines      OrderLine[]

  @@index([status])
  @@index([listedPublicly])
  @@index([materialId])
}

model Consumable {
  id            String @id @default(cuid())
  name          String @unique
  unit          String // tube, blade, litre
  qtyOnHand     Int
  reorderPoint  Int
  unitCostCents Int

  movements StockMovement[]
}

enum MovementKind {
  RECEIVED
  RESERVED
  RELEASED
  CONSUMED
  ADJUSTED
  WASTED
}

/// Append-only audit trail. Every change to stock writes one of these with who
/// did it and when, so "where did that slab go" always has an answer.
model StockMovement {
  id           String       @id @default(cuid())
  kind         MovementKind
  slabId       String?
  offcutId     String?
  consumableId String?
  qty          Int          @default(1)
  userId       String
  orderId      String?
  note         String?
  createdAt    DateTime     @default(now())

  slab       Slab?       @relation(fields: [slabId], references: [id])
  offcut     Offcut?     @relation(fields: [offcutId], references: [id])
  consumable Consumable? @relation(fields: [consumableId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  order      Order?      @relation(fields: [orderId], references: [id])

  @@index([createdAt])
  @@index([kind])
  // "Which job holds this piece" reads a piece's newest RESERVED row. With only
  // createdAt to go on, a piece with no reservation scanned the whole log.
  @@index([offcutId, createdAt])
  @@index([slabId, createdAt])
  // A job's own movements, and what it has reserved (the job page).
  @@index([orderId, kind])
}

// ---------------------------------------------------------------- orders

enum CustomerSource {
  WEBSITE
  OFFCUTS_PAGE
  PHONE
  REFERRAL
  REPEAT
  WALK_IN
}

/// Who the client is. A company — a builder or kitchen firm hiring us for one
/// of their own customers — is the client in its own right: it orders, it
/// pays, and the homeowner is recorded on the job as the site contact.
enum CustomerKind {
  PERSON
  COMPANY
}

model Customer {
  id        String         @id @default(cuid())
  kind      CustomerKind   @default(PERSON)
  /// A person's name, or a company's trading name.
  name      String
  /// For a company: the person there you deal with.
  contactName String?
  phone     String
  email     String?
  suburb    String
  source    CustomerSource
  createdAt DateTime       @default(now())

  orders Order[]

  @@index([source])
  // Accepting a booking matches an existing customer on phone first.
  @@index([phone])
}

enum Pipeline {
  SHORT // offcut projects and small jobs
  FULL  // benchtop installs needing a template visit
}

enum JobType {
  OFFCUT_PROJECT
  VANITY_TOP
  SMALL_BENCHTOP
  REPAIR
  CUTOUT
  TOP_REMOVAL
  FULL_BENCHTOP
  SPLASHBACK
}

/// One enum for both pipelines. lib/pipeline.ts owns which stages are legal in
/// which pipeline and maps them onto a coarse phase the financials group by.
/// The eleven stages every job runs, in order, plus the one way out.
/// Order here is the progression; lib/pipeline.ts owns the legal moves.
enum OrderStatus {
  INITIAL
  QUOTE_REQUEST
  QUOTED
  ORDER_ACTIVE
  PURCHASE_ORDER
  MEASURED
  DETAILS
  FACTORY
  READY_FOR_DISPATCH
  INSTALLATION
  INVOICE
  /// Not a stage: a job abandoned before it was won.
  LOST
}

model Order {
  id            String      @id @default(cuid())
  jobNumber     String      @unique // e.g. HP-2609-041
  customerId    String
  pipeline      Pipeline
  jobType       JobType
  status        OrderStatus @default(INITIAL)
  address       String
  suburb        String
  notes         String?

  /// The person at the address, when they are not the client: the homeowner
  /// a company has hired us for. Null when the client is the homeowner.
  siteContactName  String?
  siteContactPhone String?

  // Money. Admin-only — lib/queries never selects these for an employee.
  quoteCents   Int @default(0)
  depositCents Int @default(0)

  estimatedHours Float @default(0)
  actualHours    Float @default(0)

  createdAt   DateTime  @default(now())
  wonAt       DateTime?
  completedAt DateTime?
  lostReason  String?

  /// When the office aims to have it done, set on New job. A day, kept as
  /// midnight in the business's zone. Not a promise to the client.
  targetCompletionAt DateTime?
  /// Days before the target to put a reminder in the calendar: [7, 1].
  reminderDays       Int[]     @default([])
  /// The calendar events New job made for this job (opened, due, reminders),
  /// so they can be found again. Empty when the calendar is not set up.
  calendarEventIds   String[]  @default([])
  /// When the summary went to the client by email; null if it never did.
  summaryEmailedAt   DateTime?

  customer  Customer        @relation(fields: [customerId], references: [id])
  booking   BookingRequest?
  lines     OrderLine[]
  events    ScheduleEvent[]
  movements StockMovement[]
  stages    OrderStage[]

  @@index([status])
  @@index([pipeline])
  @@index([createdAt])
  @@index([completedAt])
  // Postgres does not index a foreign key by itself.
  @@index([customerId])
}

model OrderLine {
  id          String @id @default(cuid())
  orderId     String
  description String

  materialId String?
  slabId     String?
  offcutId   String?

  sqm            Float @default(0)
  labourHours    Float @default(0)
  unitPriceCents Int   @default(0)
  lineTotalCents Int   @default(0)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id])
  slab     Slab?     @relation(fields: [slabId], references: [id])
  offcut   Offcut?   @relation(fields: [offcutId], references: [id])

  @@index([orderId])
}

// ---------------------------------------------------------------- bookings

enum BookingStatus {
  NEW
  ACCEPTED
  DECLINED
}

/// A customer asking for a time — deliberately NOT an Order.
///
/// The owner confirms before anything lands in the day: a stranger filling in a
/// form must never be able to book Gabriel into a slot he cannot do. Accepting
/// one creates the Customer, the Order and the ScheduleEvent; until then this
/// is only a request.
///
/// Written by an unauthenticated endpoint, so treat every field as hostile:
/// length-capped here, validated and rate-limited at the door.
model BookingRequest {
  id        String        @id @default(cuid())
  status    BookingStatus @default(NEW)

  name      String
  phone     String
  email     String?
  suburb    String
  jobType   JobType
  notes     String?

  /// When the customer would like it. A preference, not a commitment.
  preferredAt    DateTime
  alternateAt    DateTime?

  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  declineNote String?

  /// Set once accepted — the job this request turned into.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([status, createdAt])
}

// ---------------------------------------------------------------- scheduling

enum EventKind {
  TEMPLATE
  FABRICATE
  INSTALL
  REPAIR
  DELIVERY
}

model ScheduleEvent {
  id            String    @id @default(cuid())
  orderId       String?
  kind          EventKind
  startAt       DateTime
  endAt         DateTime
  address       String
  notes         String?
  googleEventId String?   @unique
  createdAt     DateTime  @default(now())

  order     Order?             @relation(fields: [orderId], references: [id])
  assignees ScheduleAssignee[]

  @@index([startAt])
  @@index([kind])
  // A job's bookings: the job page, and the board's latest-booking check.
  @@index([orderId, startAt])
}

model ScheduleAssignee {
  eventId String
  userId  String

  event ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

/// One spell in one stage: when the job entered it, when it left, and who moved
/// it in. The open row (exitedAt null) is the stage the job is in now.
///
/// Time in stage cannot be derived without this — status alone says where a job
/// is, never how long it has been there, and that is the whole question the
/// follow-up board exists to answer.
model OrderStage {
  id        String      @id @default(cuid())
  orderId   String
  stage     OrderStatus
  enteredAt DateTime    @default(now())
  exitedAt  DateTime?
  movedById String?

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  movedBy User? @relation(fields: [movedById], references: [id])

  @@index([orderId, enteredAt])
  @@index([stage])
}
