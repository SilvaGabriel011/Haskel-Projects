# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Required. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# The Google Workspace domain staff sign in from, e.g. haskelprojects.com.au
# Sign-in is refused for any account outside this domain.
# Leave blank ONLY for local development.
GOOGLE_WORKSPACE_DOMAIN=

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Demo mode: adds password sign-in for the seeded demo accounts so the system
# can be explored before Google sign-in is set up.
# Set to false in production — it removes the password path entirely.
DEMO_MODE=true

# Password hashes for the demo accounts. Generate each with:  npm run hash
# Format: scrypt:<salt-hex>:<hash-hex>.  Plain passwords are never stored.
# Note the ":" separators — a "$" here would be expanded away as a variable.
DEMO_ADMIN_PASSWORD_HASH=
DEMO_INSTALLER_PASSWORD_HASH=
DEMO_APPRENTICE_PASSWORD_HASH=
